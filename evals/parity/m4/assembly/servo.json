          ]
        }
      ],
      "features": [
        {
          "kind": "extrude",
          "id": "case",
          "name": "Case",
          "sketch": "body",
          "distance": "servo_height"
        },
        {
          "kind": "extrude",
          "id": "tabs",
          "name": "Flange",
          "sketch": "flange",
          "distance": "flange_thickness"
        },
        {
          "kind": "hole",
          "id": "flange_holes",
          "name": "Flange holes",
          "plane": {
            "offset": "flange_thickness"
          },
          "at": {
            "kind": "points",
            "points": [
              [
                "-flange_hole_spacing / 2",
                0
              ],
              [
                "flange_hole_spacing / 2",
                0
              ]
            ]
          },
          "diameter": "flange_hole_d"
        }
      ]
