              "width": "servo_length",
              "height": "servo_width"
            }
          ]
        },
        {
          "id": "flange",
          "entities": [
            {
              "kind": "rect",
              "center": [
                0,
                0
              ],
              "width": "flange_length",
              "height": "servo_width"
