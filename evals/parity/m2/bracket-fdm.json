{
  "ir_version": 2,
  "title": "Pocketed bracket",
  "params": [
    {"name": "length", "value": 80, "unit": "mm", "description": "bracket length", "provenance": {"source": "prompt", "quote": "80 mm"}},
    {"name": "width", "value": 60, "unit": "mm", "description": "bracket width", "provenance": {"source": "prompt", "quote": "60 mm"}},
    {"name": "thickness", "value": 10, "unit": "mm", "description": "plate thickness", "provenance": {"source": "prompt", "quote": "10 mm"}},
    {"name": "pocket_depth", "value": 5, "unit": "mm", "description": "pocket depth", "provenance": {"source": "prompt", "quote": "5 mm deep pocket"}}
  ],
  "parts": [
    {
      "id": "bracket",
      "name": "Bracket",
      "material": "PLA",
      "process": "fdm",
      "sketches": [
        {"id": "outline", "entities": [{"kind": "rect", "width": "length", "height": "width"}]},
        {"id": "pocket_outline", "plane": {"offset": "thickness"}, "entities": [{"kind": "rect", "width": 40, "height": 30}]}
      ],
      "features": [
        {"kind": "extrude", "id": "plate", "name": "Plate", "intent": "base plate", "sketch": "outline", "distance": "thickness"},
        {"kind": "extrude", "id": "pocket", "name": "Pocket", "intent": "sensor recess", "sketch": "pocket_outline", "mode": "cut", "distance": "-pocket_depth"},
        {"kind": "hole", "id": "mount", "name": "M5 mounting holes", "intent": "frame bolts", "plane": {"offset": "thickness"}, "at": {"kind": "points", "points": [[-30, 0], [30, 0]]}, "fastener": "M5"}
      ]
    }
  ]
}
