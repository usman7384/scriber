# Same renderer, parser and sampling defaults as qwen3.5:0.8b-q8_0 (the CX-13 base), so the weights are the only difference.
FROM ../../data/training/cx13/run/partwright-ir-0.8b-cx13-q8_0.gguf
RENDERER qwen3.5
PARSER qwen3.5
PARAMETER presence_penalty 1.5
PARAMETER temperature 1
PARAMETER top_k 20
PARAMETER top_p 0.95
